<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="LibraryWebServiceProject.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <title><%: Page.Title %> - Library System</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background-color: #f5f5f5;
        }

        .navbar {
            background-color: #1e3a8a;
            padding: 15px 30px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin-right: 20px;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .container {
            padding: 30px;
        }

        footer {
            margin-top: 40px;
            text-align: center;
            color: gray;
        }
    </style>
</head>

<body>
    <form runat="server">

        <!-- HEADER -->
        <div class="navbar">
            <a href="Default.aspx">Ana səhifə</a>
            <a href="Books.aspx">Kitablar</a>
            <a href="Readers.aspx">Oxucular</a>
            <a href="Borrow.aspx">Kitab verilməsi</a>
        </div>

        <!-- MAIN CONTENT -->
        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>

        <!-- FOOTER -->
        <footer>
            <p>&copy; <%: DateTime.Now.Year %> - Library Management System</p>
        </footer>

    </form>
</body>
</html>